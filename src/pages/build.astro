---
/**
 * `/build/` — Build Car.
 *
 * The page owns nothing but the vocabulary. Every figure on it is computed in
 * the browser by the same `lib/math/dynamics/*` functions that model the real
 * cars in the catalogue, and the build itself lives in the URL — so there is no
 * content here to keep in step with anything, which is the point.
 *
 * The taxonomy lists are read at build time rather than hardcoded in the
 * island, so a new drivetrain or body style appears in the form the moment it
 * appears in `src/data/taxonomy/`.
 */
import BuildCar from '../components/islands/BuildCar.svelte';
import BaseLayout from '../components/ui/BaseLayout.astro';
import { href } from '../lib/content/href.ts';
import { termsOf } from '../schemas/taxonomy.ts';

const terms = (axis: string) => termsOf(axis).map(({ id, label }) => ({ id, label }));
---

<BaseLayout
  searchKind="Tools"
  title="Build a car"
  description="Specify a car that does not exist (mass, power, gearing, drag) and run it through the same physics this site models real cars with. The build lives in the URL, so it is shareable."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Build a car</h1>
    <p class="type-body mt-3 text-ink-secondary">
      Set the numbers and watch what falls out of them. Everything here runs
      through the <a
        class="underline decoration-line underline-offset-4 hover:text-ink"
        href={href('methodology')}>same physics</a
      > the catalogue's cars are modelled with: not a simplified version for hypotheticals but
      the identical functions, so a car you invent and a car someone built are measured
      by one ruler.
    </p>
    <p class="type-body mt-3 text-sm text-ink-muted">
      Nothing is stored. The build is written into this page's address as you
      type, so sending someone the link sends them the car.
    </p>
  </header>

  <div class="mt-8">
    <BuildCar
      client:load
      compareUrl={href('compare')}
      bodyStyles={terms('body-style')}
      drivetrains={terms('drivetrain')}
      powertrains={terms('powertrain')}
    />
  </div>
</BaseLayout>
