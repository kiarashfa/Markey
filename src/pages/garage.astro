---
/**
 * `/garage/`.
 *
 * **`noindex`, but deliberately NOT blocked in robots.txt.** A blocked page is
 * never fetched, so a `noindex` on it is never seen — the "fetched but not
 * indexed" trap. The sitemap filter (Phase 8)
 * excludes it too.
 *
 * The page holds no user data of its own: everything lives in the visitor's
 * browser, and this is just the shell that renders it.
 */
import ToolIsland from '../components/islands/ToolIsland.svelte';
import BaseLayout from '../components/ui/BaseLayout.astro';
import { assetHref } from '../lib/content/href.ts';
---

<BaseLayout
  title="My Garage"
  description="Park the cars you like into numbered bays, and optionally track the ones you own. Everything stays in your browser."
  noindex
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">My Garage</h1>
    <p class="type-body mt-3 text-ink-secondary">
      Park the cars you like into numbered bays. Tick "I own this one" on any of
      them to unlock ownership tooling for that car — a value projection, a
      service log, and reminders — without changing anything else.
    </p>
    <p class="type-body mt-2 text-sm text-ink-muted">
      All of it stays in this browser. There is no account, and no server to
      send it to. It leaves only when you choose to share or back it up, and
      those two are deliberately different things.
    </p>
  </header>

  <div class="mt-8">
    <ToolIsland client:load tool="garage" src={assetHref('catalogue.json')} />
  </div>
</BaseLayout>
