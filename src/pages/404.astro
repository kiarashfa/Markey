---
/**
 * The 404.
 *
 * GitHub Pages serves `/404.html` for any path it cannot resolve, including
 * under a project prefix, so this needs nothing beyond existing at the root of
 * the build, and the host still answers with a real 404 status.
 *
 * `noindex`, and so out of the site's own search too: a soft 404 indexed under
 * its own title is worse than none.
 *
 * The same shape as the other three sites' 404s: the status, a plain headline, one
 * line in the site's own voice, then the ways out.
 */
import BaseLayout from '../components/ui/BaseLayout.astro';
import { href } from '../lib/content/href.ts';

/*
 * Chosen at build time rather than in the browser: a 404 is the page most
 * likely to be reached by something that runs no JavaScript, so it has to be
 * complete in its own HTML.
 */
const lines = [
  'This road does not go anywhere.',
  'No car is parked at this address.',
  'The satnav was confident. The page does not exist.',
];
const quip = lines[Math.floor(Math.random() * lines.length)]!;

const ways = [
  { url: href('cars'), label: 'Cars' },
  { url: href('brands'), label: 'Brands' },
  { url: href('compare'), label: 'Compare' },
  { url: href('about'), label: 'About' },
];
---

<BaseLayout title="Not found" description="No page lives at this address." noindex>
  <div class="mx-auto grid max-w-[44rem] justify-items-center pb-20 pt-10 text-center sm:pt-16">
    <p class="mb-4 text-[13px] tracking-[0.34em] text-ink-muted tabular-nums">404</p>
    <h1 class="type-display text-5xl sm:text-6xl">Not found</h1>
    <p class="mt-4 max-w-[34rem] text-lg text-ink-secondary [text-wrap:balance]">{quip}</p>

    <nav
      class="mt-10 flex w-full flex-wrap justify-center gap-x-7 gap-y-2.5 border-t border-line pt-8"
      aria-label="Ways out"
    >
      {
        ways.map((w) => (
          <a
            href={w.url}
            class="type-title border-b border-transparent pb-[3px] text-lg text-ink transition-colors hover:border-[var(--brand-accent)]"
          >
            {w.label}
          </a>
        ))
      }
    </nav>

    <p class="mt-7 max-w-[38rem] text-sm leading-relaxed text-ink-muted">
      Or search: the button in the header finds alternative names and spellings as well
      as model titles, which is very likely what brought you here.
    </p>
  </div>
</BaseLayout>
