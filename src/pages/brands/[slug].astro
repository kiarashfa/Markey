---
/**
 * `/brands/<slug>/`.
 *
 * Corporate ownership is resolved in both directions here: the brand's own
 * `parentCompany`, and every brand that names it as theirs. The second list is
 * computed rather than authored, so a subsidiary added later shows up on its
 * owner's page without anyone remembering to edit it.
 */
import BrandPage from '../../components/templates/BrandPage.astro';
import { buildCatalogue } from '../../lib/content/catalogue.ts';
import { getBrands, getCars } from '../../lib/content/entries.ts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const [brands, cars, catalogue] = await Promise.all([getBrands(), getCars(), buildCatalogue()]);
  const byId = new Map(brands.map((b) => [b.id, b]));

  return brands.map((brand) => ({
    params: { slug: brand.id },
    props: {
      brand,
      cars,
      /* The flattened records for this brand's spec-carrying entries — the
         same shape the catalog and the comparison tool read, so the brand
         page cannot disagree with either about a figure. */
      entries: catalogue.filter((car) => car.brandId === brand.id),
      parent: brand.data.parentCompany ? byId.get(brand.data.parentCompany) : undefined,
      owned: brands.filter((b) => b.data.parentCompany === brand.id),
    },
  }));
}

const { brand, cars, entries, parent, owned } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(brand.narrative);
---

<BrandPage
  brand={brand}
  cars={cars}
  entries={entries}
  parent={parent}
  owned={owned}
  proseFrontmatter={remarkPluginFrontmatter}
>
  <Content />
</BrandPage>
