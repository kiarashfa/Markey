---
/**
 * `/attributions/` — SPEC.md §6, §10.
 *
 * Not deferrable. The moment the site publishes anything derived from
 * CC BY-SA sources, attribution is a licence obligation rather than a courtesy.
 * The per-figure citations on each page do the specific work; this page is the
 * site-wide acknowledgement, and it is generated from the real bibliography so
 * it cannot fall behind the content.
 */
import Section from '../components/blocks/Section.astro';
import BaseLayout from '../components/ui/BaseLayout.astro';
import bibliography from '../data/references.json' with { type: 'json' };

const entries = [...bibliography.entries].sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout
  title="Attributions"
  description="The sources Markey is built from, and the licences they are used under."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Attributions</h1>
    <p class="type-body mt-3 max-w-prose text-lg text-ink-secondary">
      This site is assembled from other people's work. Here is whose.
    </p>
  </header>

  <Section
    title="Data sources"
    lede="Specifications come from Wikipedia's generation articles, cited at the revision they were read at — because the article will have changed by the time you check."
  >
    <div class="type-body flex flex-col gap-3 py-5 text-sm text-ink-secondary">
      <p>
        Text and specifications drawn from Wikipedia are used under
        <a
          class="underline decoration-line underline-offset-2 hover:text-ink"
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          rel="nofollow noopener"
          target="_blank">CC BY-SA 4.0</a
        >. Entity identifiers and image resolution come from Wikidata (CC0).
        Photography comes from Wikimedia Commons, licensed per file and credited
        on the page it appears on.
      </p>
      <p>
        <strong class="text-ink">Photography is credited on the photograph
        itself</strong>, not listed here. Every image carries a small
        <span class="mx-0.5 inline-flex size-4 items-center justify-center rounded-full border border-line align-[-2px] text-[0.5625rem] font-semibold">i</span>
        button giving its author, licence and source page. That is deliberate:
        a single list of every image on the site would run to many thousands of
        rows and separate each credit from the picture it belongs to, which
        serves neither the reader nor the photographer. This page stays for the
        source works the site's <em>data</em> is drawn from.
      </p>
      <p>
        Manufacturer names, model names and logos are the trademarks of their
        respective owners. They appear here only to identify those
        manufacturers' vehicles, unmodified, and nothing on this site implies
        any endorsement, partnership or affiliation.
      </p>
    </div>
  </Section>

  <Section title={`Bibliography (${entries.length})`}>
    <ul class="flex flex-col gap-4 py-5 text-sm">
      {
        entries.map((entry) => (
          <li>
            <p class="type-heading text-[0.9375rem]">
              {entry.url ? (
                <a
                  class="underline decoration-line underline-offset-2 hover:text-ink"
                  href={entry.url}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  {entry.title}
                </a>
              ) : (
                entry.title
              )}
            </p>
            <p class="type-data mt-1 text-xs text-ink-muted">
              {[
                entry.publisher,
                entry.author,
                entry.revision ? `revision ${entry.revision}` : null,
                entry.accessed ? `read ${entry.accessed}` : null,
                entry.license,
              ]
                .filter(Boolean)
                .join(' · ')}
            </p>
            {entry.note && (
              <p class="mt-1 max-w-prose text-xs leading-relaxed text-ink-muted">{entry.note}</p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
