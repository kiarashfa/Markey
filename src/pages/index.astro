---
/**
 * Homepage — the spotlight carousel as a "wow" moment, then
 * straight into practical search-first browsing directly beneath it.
 *
 * The catalog below the fold is a static list for now. Pagefind full-text
 * search (Phase 8) and the faceted, reactive catalog (Phase 4)
 * both slot into this page without moving it.
 */
import Section from '../components/blocks/Section.astro';
import EntryTable from '../components/islands/EntryTable.svelte';
import SpotlightCarousel from '../components/islands/SpotlightCarousel.svelte';
import BaseLayout from '../components/ui/BaseLayout.astro';

import { buildCatalogue } from '../lib/content/catalogue.ts';
import { getBrands, getCars } from '../lib/content/entries.ts';
import { carHref, href, imageSrc, taxonomyHref } from '../lib/content/href.ts';
import { AXES, buildTermViews } from '../lib/content/taxonomy-views.ts';
import { formatYears } from '../lib/render/format.ts';
import {
  bodyStyles as bodyStyleVocab,
  eras as eraVocab,
  powertrains as powertrainVocab,
} from '../schemas/taxonomy.ts';

const [cars, brands, catalogue] = await Promise.all([getCars(), getBrands(), buildCatalogue()]);
const brandsById = new Map(brands.map((b) => [b.id, b]));

/**
 * The curated spotlight set. A halo trim or generation flagged `spotlight` in
 * its data file — never an automatic "most recent", which would put whatever
 * was authored last in the most prominent place on the site.
 */
const spotlight = cars
  .filter((car) => car.data.spotlight)
  .map((car) => {
    const brand = brandsById.get(car.data.brandRef)!;
    const stats: { label: string; value: string }[] = [
      { label: 'Produced', value: formatYears(car.data.productionYears) },
    ];
    if (car.data.generationCode) stats.push({ label: 'Code', value: car.data.generationCode });
    if (car.data.designer) stats.push({ label: 'Designer', value: car.data.designer });

    return {
      id: car.id,
      name: car.data.name,
      kicker: brand.data.name,
      url: carHref(car.id),
      brandName: brand.data.name,
      accentColor: brand.data.accentColor,
      logoSrc: imageSrc(brand.data.logo.src),
      logoAlt: brand.data.logo.alt,
      heroSrc: car.data.hero ? imageSrc(car.data.hero.src) : undefined,
      heroAlt: car.data.hero?.alt,
      stats,
    };
  });

/**
 * Only the terms the catalogue actually uses.
 *
 * A filter row of fourteen body styles above four cars, twelve of them
 * disabled, advertises the vocabulary rather than the catalogue. These grow as
 * the catalogue does, with no editing.
 */
const usedTerms = (
  field: 'bodyStyles' | 'powertrains' | 'eras',
  vocab: { terms: { id: string; label: string }[] },
) => {
  const used = new Set(catalogue.flatMap((car) => car[field]));
  return vocab.terms.filter((term) => used.has(term.id)).map(({ id, label }) => ({ id, label }));
};

/** Browse entry points, each showing how much is actually behind it. */
const browseAxes = AXES.map((axis) => ({
  ...axis,
  count: buildTermViews(axis.axis, cars, brands).length,
})).filter((axis) => axis.count > 0);
---

<BaseLayout
  title="Markey"
  description="A free, ad-free, login-free encyclopedia of production cars. Every figure carries its source and its confidence — and a figure we don't have is shown as missing, never guessed."
  bleed
>
  {/*
    The carousel's slide titles are h2s, because which car is showing changes as
    you swipe and a document's h1 should not. The page still needs one heading
    that names it, so it lives here — visually redundant next to the wordmark,
    but not redundant to a screen reader or a crawler landing on the homepage.
  */}
  {
    spotlight.length > 0 && (
      <>
        <h1 class="sr-only">Markey — an encyclopedia of production cars</h1>
        <SpotlightCarousel client:load cars={spotlight} />
      </>
    )
  }

  <div class="mx-auto w-full max-w-(--layout-max) px-(--layout-gutter) py-10 sm:py-14">
    {
      spotlight.length === 0 && (
        <header class="mb-10">
          <h1 class="type-display text-[clamp(2rem,7vw,3.5rem)]">Markey</h1>
          <p class="type-body mt-4 max-w-lede text-lg text-ink-secondary">
            A free, ad-free, login-free encyclopedia of production cars.
          </p>
        </header>
      )
    }

    <section>
      <h2 class="type-title text-xl">Browse</h2>
      <p class="type-body mt-2 max-w-readable text-sm text-ink-secondary">
        Every browse axis is a view computed over tagged entries, so nothing
        breaks when a car is reclassified. Two of them — origin and era — are
        never tagged by hand at all.
      </p>

      {
        browseAxes.length > 0 ? (
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {browseAxes.map((axis) => (
              <li>
                <a
                  href={taxonomyHref(axis.axis)}
                  class="pressable flex h-full flex-col rounded-lg border border-line bg-surface-1 p-4 transition-colors duration-150 hover:border-line-strong hover:bg-surface-2"
                >
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="type-heading text-base">{axis.title}</span>
                    <span class="text-xs text-ink-muted tabular-nums">{axis.count}</span>
                  </span>
                  <span class="mt-1.5 text-xs leading-relaxed text-ink-muted">
                    {axis.description}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-5 text-sm text-ink-muted">
            Browse axes appear as soon as there are tagged entries behind them.
          </p>
        )
      }
    </section>

    {
      catalogue.length > 0 && (
        <Section
          title="In the catalog"
          lede="Generations and halo trims — the entries that carry the specifications. Filter it, or sort by any column."
        >
          <div class="py-5">
            {/*
              `client:visible` — the table is below the carousel, so a visitor
              who never scrolls never pays for it. It hydrates in time either
              way, because it only becomes interactive once it is on screen.
            */}
            <EntryTable
              client:visible
              cars={catalogue}
              caption="Every car in the catalog"
              facets={[
                { label: 'Body style', field: 'bodyStyles', terms: usedTerms('bodyStyles', bodyStyleVocab) },
                { label: 'Powertrain', field: 'powertrains', terms: usedTerms('powertrains', powertrainVocab) },
                { label: 'Era', field: 'eras', terms: usedTerms('eras', eraVocab) },
              ]}
            />
          </div>
        </Section>
      )
    }

    <p class="mt-8 text-sm">
      <a
        class="underline decoration-line underline-offset-4 hover:text-ink"
        href={href('cars')}
      >
        The full catalog, with every facet &rarr;
      </a>
    </p>
  </div>
</BaseLayout>
