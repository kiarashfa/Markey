---
/**
 * Homepage: the spotlight as the one moment of spectacle, then the ways in.
 *
 * It holds a fixed amount however large the catalog grows: five spotlight cars
 * picked weekly from the ones flagged for it, the browse axes, the busiest
 * brands, and the door to the full catalog at `/cars/`. It used to carry the
 * whole catalog as a table, which made it the heaviest page on the site and
 * would have made it unusable at a few thousand entries.
 */
import SpotlightCarousel from '../components/islands/SpotlightCarousel.svelte';
import BaseLayout from '../components/ui/BaseLayout.astro';

import { buildCatalogue } from '../lib/content/catalogue.ts';
import { getBrands, getCars } from '../lib/content/entries.ts';
import { brandHref, carHref, href, imageSrc, taxonomyHref } from '../lib/content/href.ts';
import { srcsetFor } from '../lib/content/srcset.ts';
import { AXES, buildTermViews } from '../lib/content/taxonomy-views.ts';
import { formatYears } from '../lib/render/format.ts';
import { weeklyPick } from '../lib/showcase.ts';

const [cars, brands, catalogue] = await Promise.all([getCars(), getBrands(), buildCatalogue()]);
const brandsById = new Map(brands.map((b) => [b.id, b]));

/**
 * The spotlight: five cars a week from those flagged `spotlight` in their data
 * file, never an automatic "most recent". Only flagged cars with a photograph,
 * because a spotlight without one is a headline over empty space.
 */
const spotlight = weeklyPick(
  cars.filter((car) => car.data.spotlight && car.data.hero),
  5,
).map((car) => {
  const brand = brandsById.get(car.data.brandRef)!;
  const stats: { label: string; value: string }[] = [
    { label: 'Produced', value: formatYears(car.data.productionYears) },
  ];
  if (car.data.generationCode) stats.push({ label: 'Code', value: car.data.generationCode });
  if (car.data.designer) stats.push({ label: 'Designer', value: car.data.designer });

  return {
    id: car.id,
    name: car.data.name,
    kicker: brand.data.name,
    url: carHref(car.id),
    brandName: brand.data.name,
    accentColor: brand.data.accentColor,
    logoSrc: imageSrc(brand.data.logo.src),
    logoAlt: brand.data.logo.alt,
    heroSrc: car.data.hero ? imageSrc(car.data.hero.src) : undefined,
    heroSrcset: car.data.hero ? srcsetFor(imageSrc(car.data.hero.src), car.data.hero.width) : undefined,
    heroAlt: car.data.hero?.alt,
    stats,
  };
});

/** Browse entry points, each showing how much is actually behind it. */
const browseAxes = AXES.map((axis) => ({
  ...axis,
  count: buildTermViews(axis.axis, cars, brands).length,
})).filter((axis) => axis.count > 0);

/* The twelve brands with the most entries, then listed alphabetically: the
   busiest doors, in an order a reader can scan. */
const perBrand = new Map<string, number>();
for (const row of catalogue) perBrand.set(row.brandId, (perBrand.get(row.brandId) ?? 0) + 1);
const topBrands = [...perBrand]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12)
  .map(([id, count]) => ({ brand: brandsById.get(id)!, count }))
  .filter((b) => b.brand)
  .sort((a, b) => a.brand.data.name.localeCompare(b.brand.data.name));

const nameplates = cars.filter((c) => c.data.kind === 'model').length;
---

<BaseLayout
  title="Markey"
  description="A free encyclopedia of production cars. Every figure carries its source and its confidence, and a figure we don't have is shown as missing, never guessed."
  bleed
>
  {/*
    The carousel's slide titles are h2s, because which car is showing changes as
    you swipe and a document's h1 should not. The page still needs one heading
    that names it, so it lives here.
  */}
  {
    spotlight.length > 0 && (
      <>
        <h1 class="sr-only">Markey, an encyclopedia of production cars</h1>
        <SpotlightCarousel client:load cars={spotlight} />
      </>
    )
  }

  <div class="mx-auto w-full max-w-(--layout-max) px-(--layout-gutter) py-10 sm:py-14">
    {
      spotlight.length === 0 && (
        <header class="mb-10">
          <h1 class="type-display text-[clamp(2rem,7vw,3.5rem)]">Markey</h1>
          <p class="type-body mt-4 text-lg text-ink-secondary">
            A free encyclopedia of production cars.
          </p>
        </header>
      )
    }

    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
        <h2 class="type-title text-xl">The catalog</h2>
        <a class="text-sm text-ink-secondary hover:text-ink" href={href('cars')}>
          All {catalogue.length} cars &rarr;
        </a>
      </div>
      <p class="type-body mt-4 text-sm text-ink-secondary">
        {catalogue.length} generations and halo trims across {nameplates} nameplates and {brands.length} brands,
        every figure carrying its source. Filter and sort them by brand, body style, powertrain, era
        and more.
      </p>

      {
        topBrands.length > 0 && (
          <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
            {topBrands.map(({ brand, count }) => (
              <li>
                <a
                  href={brandHref(brand.id)}
                  class="pressable flex items-center gap-3 rounded-lg border border-line bg-surface-1 p-3 transition-colors duration-150 hover:border-line-strong hover:bg-surface-2"
                >
                  <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md border border-line bg-white p-1">
                    <img src={imageSrc(brand.data.logo.src)} alt="" class="size-full object-contain" loading="lazy" />
                  </span>
                  <span class="min-w-0 flex-1 truncate text-sm font-medium">{brand.data.name}</span>
                  <span class="text-xs tabular-nums text-ink-muted">{count}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={href('cars')}
          class="pressable inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm font-medium transition-colors duration-150 hover:bg-surface-2"
        >
          Open the catalog <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={href('brands')}
          class="pressable inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm text-ink-secondary transition-colors duration-150 hover:bg-surface-2 hover:text-ink"
        >
          All {brands.length} brands
        </a>
      </div>
    </section>

    <section class="mt-14">
      <div class="border-b border-line pb-3">
        <h2 class="type-title text-xl">Browse</h2>
      </div>
      <p class="type-body mt-4 text-sm text-ink-secondary">
        Every browse axis is a view computed over tagged entries, so nothing breaks when a car is
        reclassified. Two of them, origin and era, are never tagged by hand at all.
      </p>

      {
        browseAxes.length > 0 ? (
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {browseAxes.map((axis) => (
              <li>
                <a
                  href={taxonomyHref(axis.axis)}
                  class="pressable flex h-full flex-col rounded-lg border border-line bg-surface-1 p-4 transition-colors duration-150 hover:border-line-strong hover:bg-surface-2"
                >
                  <span class="flex items-baseline justify-between gap-2">
                    <span class="type-heading text-base">{axis.title}</span>
                    <span class="text-xs text-ink-muted tabular-nums">{axis.count}</span>
                  </span>
                  <span class="mt-1.5 text-xs leading-relaxed text-ink-muted">{axis.description}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-5 text-sm text-ink-muted">
            Browse axes appear as soon as there are tagged entries behind them.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
