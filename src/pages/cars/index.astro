---
/**
 * `/cars/` — the full catalog index.
 *
 * Not in SPEC.md §6's table, which lists only `/cars/<slug>/`. Added because
 * the header nav and every car page's breadcrumb need somewhere real to point,
 * and because an indexable, crawlable list of every nameplate is exactly the
 * kind of page SPEC.md §12 wants to exist.
 *
 * This is a static list. The filtered/sorted reactive catalog with facets
 * (SPEC.md §9.1) is Phase 4 work and replaces the body of this page.
 */
import CarCard from '../../components/blocks/CarCard.astro';
import Section from '../../components/blocks/Section.astro';
import BaseLayout from '../../components/ui/BaseLayout.astro';
import { getBrands, getCars } from '../../lib/content/entries.ts';

const [cars, brands] = await Promise.all([getCars(), getBrands()]);
const brandsById = new Map(brands.map((b) => [b.id, b]));

const models = cars
  .filter((c) => c.data.kind === 'model')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const generations = cars
  .filter((c) => c.data.kind !== 'model')
  .sort((a, b) => a.data.productionYears.start - b.data.productionYears.start);
---

<BaseLayout
  title="Cars"
  description="Every nameplate and generation in the Markey catalog, with sourced specifications."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Cars</h1>
    <p class="type-body mt-3 max-w-prose text-ink-secondary">
      Every nameplate, and every generation underneath it. A nameplate page is
      the overview; a generation page is where the specifications live.
    </p>
  </header>

  {
    models.length > 0 ? (
      <>
        <Section title={`Nameplates (${models.length})`}>
          <div class="-mx-4 py-4 sm:-mx-5">
            <div class="grid gap-3 px-4 sm:px-5 md:grid-cols-2">
              {models.map((car) => (
                <CarCard car={car} brand={brandsById.get(car.data.brandRef)} />
              ))}
            </div>
          </div>
        </Section>

        <Section title={`Generations & halo trims (${generations.length})`}>
          <div class="-mx-4 py-4 sm:-mx-5">
            <div class="grid gap-3 px-4 sm:px-5 md:grid-cols-2">
              {generations.map((car) => (
                <CarCard car={car} brand={brandsById.get(car.data.brandRef)} />
              ))}
            </div>
          </div>
        </Section>
      </>
    ) : (
      <Section title="Nameplates">
        <p class="py-5 text-sm text-ink-muted">No cars have been written up yet.</p>
      </Section>
    )
  }
</BaseLayout>
