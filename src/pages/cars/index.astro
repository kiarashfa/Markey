---
/**
 * `/cars/` — the full catalog.
 *
 * The faceted list is an island; the page itself still server-renders the
 * complete set inside it, so the catalog is crawlable and readable without
 * JavaScript. `client:load` rather than `client:visible` because this is the
 * page's entire purpose — waiting for it to scroll into view would mean the
 * controls are dead at the moment the visitor first reaches for them.
 */
import Catalog from '../../components/islands/Catalog.svelte';
import CarCard from '../../components/blocks/CarCard.astro';
import Section from '../../components/blocks/Section.astro';
import BaseLayout from '../../components/ui/BaseLayout.astro';
import { buildCatalogue } from '../../lib/content/catalogue.ts';
import { getBrands, getCars } from '../../lib/content/entries.ts';
import { assetHref } from '../../lib/content/href.ts';
import {
  bodyStyles,
  drivetrains,
  positioning,
  powertrains,
  segments,
} from '../../schemas/taxonomy.ts';

const [catalogue, cars, brands] = await Promise.all([buildCatalogue(), getCars(), getBrands()]);
const brandsById = new Map(brands.map((b) => [b.id, b]));

const models = cars
  .filter((c) => c.data.kind === 'model')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const terms = (list: { id: string; label: string }[]) =>
  list.map((t) => ({ id: t.id, label: t.label }));
---

<BaseLayout
  searchKind="Browse"
  title="Cars"
  description="Every generation in the Markey catalog, filterable by body style, powertrain, drivetrain, segment and market positioning."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Cars</h1>
    <p class="type-body mt-3 max-w-prose text-ink-secondary">
      Generations and halo trims — the entries that carry the specifications.
      Filter and sort them here; the nameplate hubs are listed underneath.
    </p>
  </header>

  <div class="mt-8">
    <Catalog
      client:load
      cars={catalogue}
      bodyStyleTerms={terms(bodyStyles.terms)}
      powertrainTerms={terms(powertrains.terms)}
      drivetrainTerms={terms(drivetrains.terms)}
      segmentTerms={terms(segments.terms)}
      positioningTerms={terms(positioning.terms)}
    />
  </div>

  {
    models.length > 0 && (
      <Section
        title={`Nameplates (${models.length})`}
        lede="A nameplate page is the overview across a car's whole history; its generations are where the specifications live."
      >
        <div class="-mx-4 py-4 sm:-mx-5">
          <div class="grid gap-3 px-4 sm:px-5 md:grid-cols-2">
            {models.map((car) => (
              <CarCard car={car} brand={brandsById.get(car.data.brandRef)} />
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <p class="mt-8 text-sm">
    <a
      class="underline decoration-line underline-offset-4 hover:text-ink"
      href={assetHref('catalogue.json')}
    >
      Machine-readable export &rarr;
    </a>
  </p>
</BaseLayout>
