---
/**
 * `/cars/<slug>/` — model hub, generation, or halo trim.
 *
 * One flat route for all three `kind`s. This is the canonical-URL promise
 * in practice: the path is type-prefixed and flat, so
 * re-parenting a generation or reclassifying a trim never moves its URL.
 */
import CarPage from '../../components/templates/CarPage.astro';
import { getBrands, getCars } from '../../lib/content/entries.ts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const [cars, brands] = await Promise.all([getCars(), getBrands()]);
  const brandsById = new Map(brands.map((b) => [b.id, b]));

  return cars.map((car) => ({
    params: { slug: car.id },
    props: {
      car,
      // Integrity guarantees this resolves — `brand-ref/unresolved` fails the
      // build otherwise, so there is no fallback to write here.
      brand: brandsById.get(car.data.brandRef)!,
      allCars: cars,
    },
  }));
}

const { car, brand, allCars } = Astro.props;

/**
 * `remarkPluginFrontmatter` carries what the Markdown plugins wrote — here,
 * the citation numbering `rehype-citations.ts` assigned to this entry's prose
 *. The template needs it to build the page's reference list.
 */
const { Content, remarkPluginFrontmatter } = await render(car.narrative);
---

<CarPage car={car} brand={brand} allCars={allCars} proseFrontmatter={remarkPluginFrontmatter}>
  <Content />
</CarPage>
