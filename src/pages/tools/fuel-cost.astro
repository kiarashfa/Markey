---
/**
 * `/tools/fuel-cost/` — SPEC.md §6, §8.1.
 */
import FuelCostCalculator from '../../components/islands/FuelCostCalculator.svelte';
import BaseLayout from '../../components/ui/BaseLayout.astro';
---

<BaseLayout
  searchKind="Tools"
  title="Fuel cost"
  description="What a car actually costs to run, at the price you actually pay."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Fuel cost</h1>
    <p class="type-body mt-3 max-w-prose text-ink-secondary">
      Consumption, price and distance. Works the same way for litres and for
      kilowatt-hours, so a petrol car and an electric one can be compared
      honestly — as long as you give each its own price.
    </p>
  </header>

  <div class="mt-8 max-w-3xl">
    <FuelCostCalculator client:load />
  </div>
</BaseLayout>
