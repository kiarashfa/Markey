---
/**
 * `/tools/guided-browse/` — SPEC.md §6, §9.2.
 *
 * The lower-commitment discovery tool: dealbreakers only, ending in a list.
 * No ranking — that is Matchmaker's job, and keeping them distinct is what
 * stops the site having two tools that do the same thing slightly differently.
 */
import GuidedBrowse from '../../components/islands/GuidedBrowse.svelte';
import BaseLayout from '../../components/ui/BaseLayout.astro';
import { buildCatalogue } from '../../lib/content/catalogue.ts';
import { href } from '../../lib/content/href.ts';
import { bodyStyles, drivetrains, powertrains } from '../../schemas/taxonomy.ts';

const catalogue = await buildCatalogue();
const terms = (list: { id: string; label: string }[]) => list.map((t) => ({ id: t.id, label: t.label }));
---

<BaseLayout
  searchKind="Tools"
  title="Guided Browse"
  description="Narrow the catalog step by step to the cars that meet what you need. No scoring, no ranking — just a filtered list."
>
  <header>
    <h1 class="type-title text-[clamp(1.75rem,5vw,2.5rem)]">Guided Browse</h1>
    <p class="type-body mt-3 max-w-lede text-ink-secondary">
      A few questions, ending in a list of the cars that meet all of them.
      Nothing here is ranked or scored — every result satisfies what you asked
      for equally. If you want them put in an order, use{' '}
      <a class="underline decoration-line underline-offset-4 hover:text-ink" href={href('tools', 'matchmaker')}>Matchmaker</a>.
    </p>
  </header>

  <div class="mt-8">
    <GuidedBrowse
      client:load
      cars={catalogue}
      bodyStyleTerms={terms(bodyStyles.terms)}
      powertrainTerms={terms(powertrains.terms)}
      drivetrainTerms={terms(drivetrains.terms)}
    />
  </div>
</BaseLayout>
