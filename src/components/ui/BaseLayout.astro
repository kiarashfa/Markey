---
/**
 * The document shell every page renders through.
 *
 * Centralised because four things must be true on *every* page and are easy
 * to get wrong one page at a time: a canonical URL under the base path
 *, `noindex` where the page holds user state,
 * Pagefind's body marker — a narrative `.mdx` rendered without a layout emits
 * no `<html>` element at all and is silently dropped from the search index —
 * and the JSON-LD slot, so structured data can never end up in the body.
 */
import Header from './Header.astro';
import Footer from './Footer.astro';
import { absoluteHref, assetHref } from '../../lib/content/href.ts';
import { THEME_INIT_SCRIPT } from '../../lib/theme.ts';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Noindex, never a robots.txt disallow. */
  noindex?: boolean;
  /** Brand accent to theme this page's hero band with. */
  accentColor?: string;
  /** Pages that are their own full-bleed composition skip the content gutter. */
  bleed?: boolean;
  /**
   * The search filter this page belongs under.
   *
   * Pagefind indexes `<main>` and nothing else (see below), and this is the one
   * facet the results page offers. Omitted means the page is still found, just
   * not filed under a section.
   */
  searchKind?: string;
}

const {
  title,
  description,
  noindex = false,
  accentColor,
  bleed = false,
  searchKind,
} = Astro.props;

const canonical = absoluteHref(Astro.site, Astro.url.pathname);
const fullTitle = title === 'Markey' ? 'Markey · Car encyclopedia' : `${title} · Markey`;

/** Site analytics. The measurement ID is public by design, and this is the only place it is written. */
const GA_ID = 'G-HVVP7F7NRF';

/*
 * The link-preview card, drawn by `npm run brand` from the site's own mark and
 * type. One card for every page: entry photographs carry attribution terms a
 * preview on another platform would drop.
 */
const ogImage = absoluteHref(Astro.site, assetHref('og.png'));
const ogDescription =
  description ?? 'A free encyclopedia of production cars where every figure is sourced and every gap is shown.';

/*
 * `theme-color` follows the theme the page actually resolved to. On "system"
 * the attribute is absent and the OS decides, so the media queries are the
 * fallback; the observer catches the toggle without the toggle knowing.
 */
const THEME_COLOR = { light: '#fbfcfd', dark: '#0d1013', fallback: 'light' };
const themeColorSync = `(()=>{const m=document.querySelector('meta[name="theme-color"]'),r=document.documentElement,c=${JSON.stringify(THEME_COLOR)},d=matchMedia('(prefers-color-scheme: dark)'),l=matchMedia('(prefers-color-scheme: light)'),s=()=>{const t=r.dataset.theme;m.content=c[t==='light'||t==='dark'?t:d.matches?'dark':l.matches?'light':c.fallback];};s();new MutationObserver(s).observe(r,{attributes:true,attributeFilter:['data-theme']});d.addEventListener('change',s);})();`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Applies the stored theme before anything paints. It must be inline and it
      must come before the stylesheet, or the page renders in the default theme
      and then snaps to the stored one — the flash of wrong theme.
      `is:inline` keeps Astro from bundling and deferring it.
    */}
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={assetHref('favicon.svg')} />
    <link rel="apple-touch-icon" href={assetHref('apple-touch-icon.png')} />
    <link rel="manifest" href={assetHref('site.webmanifest')} />
    <meta name="theme-color" content={THEME_COLOR.light} />
    <script is:inline set:html={themeColorSync} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Markey" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Markey, an encyclopedia of production cars" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          {/* The path only: a query string or hash can carry what a reader shared, and it stays theirs. */}
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(GA_ID)},{page_location:location.origin+location.pathname});`}
          />
        </>
      )
    }
    {/* Structured data. A named slot so it lands in <head>. */}
    <slot name="jsonld" />
    <slot name="head" />
  </head>
  <body
    class="flex min-h-dvh flex-col bg-surface-0 text-ink"
    style={accentColor ? `--brand-accent: ${accentColor};` : undefined}
  >
    <Header />
    {/*
      `data-pagefind-body` on <main> rather than nowhere.

      Without it Pagefind indexes every <body>, which means the nav, the footer
      and the theme toggle are part of the text of all forty-odd pages —
      searching for "compare" then matches the nav link on every page rather
      than the page about comparing. Marking one element makes Pagefind index
      only marked elements, so the index becomes the page's own content.

      A `noindex` page is excluded from search for the same reason it is
      excluded from the sitemap: it holds the visitor's own state and has
      nothing to find.
    */}
    <main
      id="main"
      class="flex-1"
      data-pagefind-body={noindex ? undefined : true}
      data-pagefind-filter={searchKind ? `section:${searchKind}` : undefined}
    >
      {
        bleed ? (
          <slot />
        ) : (
          <div class="mx-auto w-full max-w-(--layout-max) px-(--layout-gutter) py-10 sm:py-14">
            <slot />
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>
