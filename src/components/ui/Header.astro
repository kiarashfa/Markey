---
/**
 * Site chrome — a translucent layer content scrolls under rather than an
 * opaque strip that permanently eats a band of the viewport.
 *
 * Nav labels name their contents rather than hiding behind generic umbrellas
 * (the design guidance, "direct, specific labels"): "Browse" would tell a visitor
 * nothing that "Body styles" doesn't tell them better.
 *
 * **The nav is split into two groups.** The catalogue — the things the site is
 * *about* — and the tools you do something with. They were one undifferentiated
 * row of seven, which is where a visitor stops reading and starts scanning.
 *
 * The right cluster is search, theme and about, one icon each. The search
 * button grows into a field in the header itself, the section links making way
 * for it, and the results drop below it; the full search page is one link on.
 */
import ThemeToggle from '../islands/ThemeToggle.svelte';
import { assetHref, href, taxonomyHref } from '../../lib/content/href.ts';
import favicon from '../../../public/favicon.svg?raw';

/**
 * The mark beside the wordmark is the favicon itself, read at build time, so
 * the tab and the header cannot drift into two drawings. It is inlined rather
 * than used as an <img> because the file switches its ink on the OS scheme,
 * and the header has to follow the site's theme instead: a reader on a light
 * machine who chose dark would otherwise get a dark mark on a dark bar. The
 * theme block is dropped, the ink becomes `currentColor`, and the mask gets an
 * id of its own so it cannot collide with anything else on the page.
 */
const markSvg = favicon
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replaceAll('var(--ink)', 'currentColor')
  .replaceAll('id="cut"', 'id="markey-mark-cut"')
  .replaceAll('url(#cut)', 'url(#markey-mark-cut)')
  .replace('<svg ', '<svg class="size-[26px]" aria-hidden="true" ')
  .trim();

/** The catalogue: what the site holds. */
const browse = [
  { label: 'Cars', url: href('cars') },
  { label: 'Brands', url: href('brands') },
  { label: 'Body styles', url: taxonomyHref('body-style') },
  { label: 'Eras', url: taxonomyHref('era') },
];

/** The tools: what you can do with it. */
const tools = [
  { label: 'Compare', url: href('compare') },
  { label: 'Test Drive', url: href('test-drive') },
  { label: 'Build', url: href('build') },
  { label: 'Garage', url: href('garage') },
  { label: 'Tools', url: href('tools') },
];

const current = Astro.url.pathname;

/** What each first path segment holds, for the label beside a search result. */
const kinds = {
  cars: 'Car',
  brands: 'Brand',
  concepts: 'Concept',
  'body-style': 'Body style',
  era: 'Era',
  drivetrain: 'Drivetrain',
  powertrain: 'Powertrain',
  segment: 'Segment',
  positioning: 'Positioning',
  origin: 'Origin',
  tools: 'Tool',
};
const searchIcon =
  '<circle cx="11" cy="11" r="6.5"></circle><line x1="15.8" y1="15.8" x2="20.5" y2="20.5"></line>';

/**
 * Marks the section a page belongs to, not just an exact URL match.
 *
 * `/cars/toyota-86-zn6/` should light up "Cars". The homepage is excluded
 * because `/Markey/` is a prefix of literally every page.
 */
const isCurrent = (url: string) => url !== href() && current.startsWith(url);
---

<header
  class="material sticky top-0 z-50 border-b border-line bg-surface-0/75 backdrop-blur-xl backdrop-saturate-150"
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface-2 focus:px-3 focus:py-2 focus:text-sm"
  >
    Skip to content
  </a>

  <div class="mx-auto flex w-full max-w-(--layout-max) flex-wrap items-center gap-x-6 gap-y-2 px-(--layout-gutter) py-3.5">
    <a href={href()} class="pressable flex shrink-0 items-center gap-2.5 text-ink" data-hs-logo>
      <Fragment set:html={markSvg} />
      <span class="type-title text-[1.4rem] leading-none tracking-tight">Markey</span>
    </a>

    <nav
      aria-label="Primary"
      class="order-3 min-w-0 flex-1 basis-full sm:order-none sm:basis-auto"
      data-hs-fade
    >
      <ul class="flex items-center gap-x-5 overflow-x-auto text-sm [scrollbar-width:none]">
        {
          browse.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={isCurrent(item.url) ? 'page' : undefined}
                class="group block whitespace-nowrap py-1 text-ink-secondary transition-colors duration-150 hover:text-ink aria-[current=page]:text-ink"
              >
                <span class="border-b border-transparent pb-[3px] transition-colors duration-150 group-hover:border-[var(--brand-accent)] group-aria-[current=page]:border-[var(--brand-accent)]">{item.label}</span>
              </a>
            </li>
          ))
        }

        {/* A hairline, not a gap: the two groups are different in kind, and a
            wider gap alone reads as an accident of spacing. */}
        <li aria-hidden="true" class="h-4 w-px shrink-0 bg-line"></li>

        {
          tools.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={isCurrent(item.url) ? 'page' : undefined}
                class="group block whitespace-nowrap py-1 text-ink-secondary transition-colors duration-150 hover:text-ink aria-[current=page]:text-ink"
              >
                <span class="border-b border-transparent pb-[3px] transition-colors duration-150 group-hover:border-[var(--brand-accent)] group-aria-[current=page]:border-[var(--brand-accent)]">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      The theme island is `client:load`: a theme control that only works after
      scrolling would be worse than none. Search is plain markup and a module
      script, and the index, the expensive part, is only fetched when it opens.
    */}
    <div class="ml-auto flex shrink-0 items-center gap-2 sm:ml-0">
      <div
        class="hs"
        data-hs
        data-hs-base={import.meta.env.BASE_URL}
        data-hs-bundle={assetHref('pagefind/pagefind.js')}
        data-hs-all={href('search')}
        data-hs-kinds={JSON.stringify(kinds)}
      >
        <div class="hs-field" data-hs-field>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={searchIcon} />
          <input type="search" placeholder="Search cars, brands, concepts" aria-label="Search Markey" autocomplete="off" />
          <button class="hs-close" type="button" data-hs-close aria-label="Close search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7 7l10 10M17 7 7 17" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
        <button
          type="button"
          class="pressable inline-flex size-8 items-center justify-center rounded-full border border-line-strong text-ink-secondary transition-colors duration-150 hover:bg-surface-2 hover:text-ink"
          data-hs-button
          aria-label="Search"
          aria-expanded="false"
          aria-controls="site-search"
          title="Search (press /)"
        >
          <svg viewBox="0 0 24 24" class="size-[15px]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={searchIcon} />
        </button>
        <div class="hs-panel" id="site-search" data-hs-panel>
          <div class="hs-results" data-hs-results aria-live="polite">
            <p class="hs-status">Cars, brands, concepts and the methodology behind the modelled figures.</p>
          </div>
        </div>
      </div>
      <ThemeToggle client:load />
      <a
        href={href('about')}
        class="pressable inline-flex size-8 items-center justify-center rounded-full border border-line-strong text-ink-secondary transition-colors duration-150 hover:bg-surface-2 hover:text-ink"
        aria-label="About Markey"
      >
        <svg viewBox="0 0 24 24" class="size-[15px]" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 11.2v5.1"></path>
          <path d="M12 7.9h.01" stroke-linecap="round"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  import { initHeaderSearch } from '../../lib/header-search.ts';
  initHeaderSearch();
</script>
