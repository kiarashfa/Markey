---
/**
 * Site chrome — a translucent layer content scrolls under rather than an
 * opaque strip that permanently eats a band of the viewport (apple-design §12).
 *
 * Nav labels name their contents rather than hiding behind generic umbrellas
 * (apple-design §16, "direct, specific labels"): "Browse" would tell a visitor
 * nothing that "Body styles" doesn't tell them better.
 */
import ThemeToggle from '../islands/ThemeToggle.svelte';
import { href, taxonomyHref } from '../../lib/content/href.ts';

const nav = [
  { label: 'Cars', url: href('cars') },
  { label: 'Brands', url: href('brands') },
  { label: 'Compare', url: href('compare') },
  { label: 'Build', url: href('build') },
  { label: 'Tools', url: href('tools') },
  { label: 'Body styles', url: taxonomyHref('body-style') },
  { label: 'Eras', url: taxonomyHref('era') },
];

const current = Astro.url.pathname;
---

<header
  class="material sticky top-0 z-50 border-b border-line bg-surface-0/75 backdrop-blur-xl backdrop-saturate-150"
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface-2 focus:px-3 focus:py-2 focus:text-sm"
  >
    Skip to content
  </a>

  <div class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-x-5 gap-y-2 px-5 py-3 sm:px-8">
    <a href={href()} class="pressable type-title shrink-0 text-lg tracking-tight">
      Markey
    </a>

    <nav aria-label="Primary" class="min-w-0 flex-1 order-3 basis-full sm:order-none sm:basis-auto">
      <ul class="flex items-center gap-1 overflow-x-auto text-sm [scrollbar-width:none] sm:gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.url}
                aria-current={current.startsWith(item.url) ? 'page' : undefined}
                class="block whitespace-nowrap rounded-md px-2.5 py-1.5 text-ink-secondary transition-colors duration-150 hover:bg-surface-2 hover:text-ink aria-[current=page]:bg-surface-2 aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      Search sits in the right cluster rather than in the nav list: the nav
      scrolls horizontally on a narrow screen and search is the one thing that
      must never scroll out of reach. A plain link, not a box — the box lives
      on the page it leads to, where its index is loaded and its results have
      room, and a header box that cannot search until an index downloads would
      be a control that lies about being ready.

      `client:load` on the theme control — a toggle that only works after
      scrolling would be worse than none, and it is the first thing some
      visitors reach for.
    */}
    <div class="ml-auto flex shrink-0 items-center gap-1 sm:ml-0">
      <a
        href={href('search')}
        aria-current={current.startsWith(href('search')) ? 'page' : undefined}
        class="flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm text-ink-secondary transition-colors duration-150 hover:bg-surface-2 hover:text-ink aria-[current=page]:bg-surface-2 aria-[current=page]:text-ink"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          class="size-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <circle cx="7" cy="7" r="4.5"></circle>
          <path d="M10.5 10.5 14 14" stroke-linecap="round"></path>
        </svg>
        <span class="max-sm:sr-only">Search</span>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>
