---
/**
 * Taxonomy tags as links to their computed views.
 *
 * SPEC.md §2 principle 2: these point at *views over* tagged entries, never at
 * a place the car "lives". Re-tagging an entry changes which lists it appears
 * in and never breaks a link to the entry itself.
 */
import { taxonomyHref } from '../../lib/content/href.ts';

interface Props {
  label: string;
  axis: string;
  terms: { id: string; label: string }[];
}

const { label, axis, terms } = Astro.props;
---

{
  terms.length > 0 && (
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
      <span class="text-sm text-ink-secondary">{label}</span>
      <ul class="flex flex-wrap gap-1.5">
        {terms.map((term) => (
          <li>
            <a
              href={taxonomyHref(axis, term.id)}
              class="pressable inline-block rounded-full border border-line bg-surface-1 px-2.5 py-1 text-xs font-medium text-ink-secondary transition-colors duration-150 hover:border-line-strong hover:text-ink"
            >
              {term.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
