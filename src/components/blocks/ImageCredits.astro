---
/**
 * Attribution, rendered — SPEC.md §10.
 *
 * Every image's legal basis is recorded per file so it is auditable rather
 * than assumed, and this is where that record becomes visible to a reader.
 * Licences that require naming the author say the author's name; a mark shown
 * under trademark nominative use says that instead of pretending to be
 * copyright-licensed, because they are different questions.
 */
import { ATTRIBUTION_REQUIRED, type ImageRef } from '../../schemas/primitives.ts';

interface Props {
  images: ImageRef[];
  compact?: boolean;
}

const { images, compact = false } = Astro.props;

const LICENSE_LABELS: Record<string, string> = {
  cc0: 'CC0',
  'public-domain': 'Public domain',
  'cc-by': 'CC BY',
  'cc-by-sa': 'CC BY-SA',
  'cc-by-nc': 'CC BY-NC',
  'cc-by-nd': 'CC BY-ND',
  gfdl: 'GFDL',
  'manufacturer-press-grant': 'Manufacturer press grant',
  'fair-use-editorial': 'Editorial fair use',
  'trademark-nominative-use': 'Trademark, nominative use',
};

function licenseText(image: ImageRef): string {
  const { credit } = image;
  const base = LICENSE_LABELS[credit.licenseType] ?? credit.licenseType;
  return credit.licenseVersion ? `${base} ${credit.licenseVersion}` : base;
}
---

{
  images.length > 0 && (
    <ul class:list={['flex flex-col gap-1.5', compact ? 'text-xs' : 'text-xs sm:text-sm']}>
      {images.map((image) => (
        <li class="text-ink-muted">
          <span class="text-ink-secondary">{image.credit.title ?? image.alt}</span>
          {ATTRIBUTION_REQUIRED.has(image.credit.licenseType) && image.credit.author && (
            <> &middot; {image.credit.author}</>
          )}
          {' · '}
          <a
            class="underline decoration-line underline-offset-2 hover:text-ink"
            href={image.credit.sourceUrl}
            rel="nofollow noopener"
            target="_blank"
          >
            {licenseText(image)}
          </a>
          {image.credit.licenseNote && (
            <span class="mt-0.5 block max-w-prose leading-relaxed">
              {image.credit.licenseNote}
            </span>
          )}
        </li>
      ))}
    </ul>
  )
}
