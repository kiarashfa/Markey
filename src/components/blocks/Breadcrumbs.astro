---
/**
 * Wayfinding (apple-design §16): every page answers "where am I, and how do I
 * get back out". On a car page the trail is the real content hierarchy —
 * model hub → generation → halo trim — walked by `parentChain()`.
 *
 * It also emits its own `BreadcrumbList` structured data, from
 * the same array it renders. Putting the markup here rather than in each page's
 * head is what makes the two impossible to disagree: there is one trail, and
 * both the visible list and the machine-readable one are built from it.
 */
import { absoluteHref } from '../../lib/content/href.ts';
import { breadcrumbJsonLd, serialiseJsonLd } from '../../lib/render/jsonld.ts';

interface Crumb {
  label: string;
  url?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

/**
 * The trail as absolute URLs, with the last item unlinked.
 *
 * The last crumb is the page you are on. It is rendered as text rather than a
 * link, and the structured data has to agree — a `BreadcrumbList` whose final
 * item links to itself describes a trail that does not end.
 */
const structured = breadcrumbJsonLd(
  crumbs.map((crumb, index) => ({
    label: crumb.label,
    url:
      index === crumbs.length - 1 || !crumb.url || crumb.url === '#'
        ? undefined
        : absoluteHref(Astro.site, crumb.url),
  })),
);
---

{structured && <script type="application/ld+json" is:inline set:html={serialiseJsonLd(structured)} />}

<nav aria-label="Breadcrumb" class="min-w-0">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-ink-secondary">
    {
      crumbs.map((crumb, i) => (
        <li class="flex min-w-0 items-center gap-1.5">
          {i > 0 && (
            <span aria-hidden="true" class="text-ink-muted">
              /
            </span>
          )}
          {crumb.url && i < crumbs.length - 1 ? (
            <a class="truncate hover:text-ink hover:underline" href={crumb.url}>
              {crumb.label}
            </a>
          ) : (
            <span class="truncate text-ink" aria-current={i === crumbs.length - 1 ? 'page' : undefined}>
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
