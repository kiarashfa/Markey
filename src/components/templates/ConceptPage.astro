---
/**
 * Concept / prototype page — SPEC.md §5.3.
 *
 * A genuinely lighter content type: no trims, no market variants, no price.
 * Its distinctive field is `fate`, which is the thing a reader actually wants
 * to know about a concept car — whether it became something, survived, or was
 * crushed.
 */
import Breadcrumbs from '../blocks/Breadcrumbs.astro';
import FactRow from '../blocks/FactRow.astro';
import HeroBand from '../blocks/HeroBand.astro';
import Gallery from '../islands/Gallery.svelte';
import Section from '../blocks/Section.astro';
import SpecRow from '../blocks/SpecRow.astro';
import TaxonomyStrip from '../blocks/TaxonomyStrip.astro';
import References from '../blocks/References.astro';
import BaseLayout from '../ui/BaseLayout.astro';

import type { JoinedBrand, JoinedCar, JoinedConcept } from '../../lib/content/entries.ts';
import { brandHref, carHref, conceptHref, href } from '../../lib/content/href.ts';
import { toGalleryImages } from '../../lib/render/images.ts';
import { labelFor } from '../../schemas/taxonomy.ts';
import {
  buildPageReferences,
  dataCitationsOf,
  proseCitationsOf,
} from '../../lib/render/citations.ts';
import { BIBLIOGRAPHY } from '../../lib/content/bibliography.ts';

interface Props {
  concept: JoinedConcept;
  brand: JoinedBrand;
  relatedCar?: JoinedCar;
  proseFrontmatter?: unknown;
}

const { concept, brand, relatedCar, proseFrontmatter } = Astro.props;
const { data } = concept;

/** This page's own numbered references — SPEC.md §5.5. */
const { list: references, numbers: citationNumbers } = buildPageReferences(
  proseCitationsOf(proseFrontmatter),
  dataCitationsOf(data),
  BIBLIOGRAPHY,
);

const FATE_LABELS: Record<string, string> = {
  production: 'Reached production',
  'one-off-surviving': 'One-off, still exists',
  destroyed: 'Destroyed',
  unknown: 'Fate unknown',
};

---

<BaseLayout
  searchKind="Concepts"
  title={data.name}
  description={`${data.name} — concept car unveiled at ${data.unveiledAt}, ${data.unveiledYear}.`}
  accentColor={brand.data.accentColor}
  bleed
>
  <HeroBand
    title={data.name}
    eyebrow="Concept"
    accentColor={brand.data.accentColor}
    brandName={brand.data.name}
    brandUrl={brandHref(brand.id)}
    brandLogo={brand.data.logo}
    hero={data.hero}
    stats={[
      { label: 'Unveiled', value: String(data.unveiledYear) },
      { label: 'Shown at', value: data.unveiledAt },
      { label: 'Fate', value: FATE_LABELS[data.fate] ?? data.fate },
    ]}
  />

  <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:px-8 sm:py-10">
    <Breadcrumbs
      crumbs={[
        { label: 'Concepts', url: href('concepts') },
        { label: brand.data.name, url: brandHref(brand.id) },
        { label: data.name, url: conceptHref(concept.id) },
      ]}
    />

    <div class="mt-6">
      <TaxonomyStrip
        axes={[
          {
            label: 'Body style',
            axis: 'body-style',
            terms: data.bodyStyles.map((id) => ({ id, label: labelFor('body-style', id) ?? id })),
          },
          {
            label: 'Powertrain',
            axis: 'powertrain',
            terms: data.powertrains.map((id) => ({ id, label: labelFor('powertrain', id) ?? id })),
          },
        ]}
      />
    </div>

    <article class="prose type-body mt-8 max-w-readable text-[0.975rem] leading-relaxed text-ink-secondary">
      <slot />
    </article>

    <Section title="Overview" as="dl">
      <FactRow label="Manufacturer" values={[brand.data.name]} />
      <FactRow label="Unveiled at" values={[`${data.unveiledAt}, ${data.unveiledYear}`]} />
      {data.designer && <FactRow label="Designer" values={[data.designer]} />}
      <FactRow label="Fate" values={[FATE_LABELS[data.fate] ?? data.fate]} />
      {
        relatedCar && (
          <FactRow label="Led to">
            <a class="underline decoration-line underline-offset-2" href={carHref(relatedCar.id)}>
              {relatedCar.data.name}
            </a>
          </FactRow>
        )
      }
    </Section>

    <Section
      title="Claimed figures"
      lede="Concept figures are usually manufacturer claims that were never independently tested. Each one's status says how far it can be trusted."
      as="dl"
    >
      <SpecRow label="Power" value={data.power} citations={citationNumbers} />
      <SpecRow label="Torque" value={data.torque} citations={citationNumbers} />
      <SpecRow label="Mass" value={data.mass} citations={citationNumbers} />
      <SpecRow label="0–100 km/h" value={data.zeroToHundredKph} citations={citationNumbers} />
      <SpecRow label="Top speed" value={data.topSpeed} citations={citationNumbers} />
      <SpecRow label="Drag coefficient" value={data.dragCoefficient} citations={citationNumbers} />
    </Section>

    {
      data.gallery.length > 0 && (
        <Section
          title="Gallery"
          lede="Select a photograph to open it full screen. Each one carries its own credit and licence."
        >
          <div class="-mx-4 px-4 py-4 sm:-mx-5 sm:px-5">
            <Gallery client:visible images={toGalleryImages(data.gallery)} />
          </div>
        </Section>
      )
    }
    <References references={references} />
  </div>
</BaseLayout>
